# name: test_mise_toml_features[xdist-syrupy-no_docs-private]
  '''
  min_version = "2026.2.5"
  
  [hooks]
  postinstall = [
      "uv sync",
      "[ -d .git ] && prek install || { echo \"No git repository found. If this is a new project, run \\`mise run init\\` to create it.\"; }",
  ]
  
  [tools]
  betterleaks = "latest"
  "pipx:copier" = "latest"
  prek = "latest"
  uv = "latest"
  
  [settings]
  lockfile = true
  
  [tasks.build]
  description = "Build distribution package"
  raw_args = true
  run = "uv build"
  
  [tasks.init]
  description = "Initialize git repository once on project creation"
  run = [
      '[ ! -d .git ] || { echo "git repository already exists"; exit 1; }',
      "git init",
      "mise install",
      "git add .",
      "git commit -m 'Create project from template'",
  ]
  
  [tasks.lint]
  description = "Run all formatters and static checks"
  raw_args = true
  run = "prek run --all-files"
  
  [tasks.lt]
  description = "Run all formatters, static checks and tests"
  run = [
      { task = "lint" },
      { task = "test" },
  ]
  
  [tasks.release]
  description = "Create and push a release tag (patch/minor/major)"
  raw_args = true
  run = "uv run bump-my-version bump -v"
  
  [tasks.secretscan]
  description = "Scan git history for secrets"
  raw_args = true
  run = "betterleaks git . --redact"
  
  [tasks.snapup]
  description = "Update test snapshots"
  raw_args = true
  run = "uv run pytest --snapshot-update --numprocesses 0"
  
  [tasks.test]
  description = "Run tests"
  raw_args = true
  run = "uv run pytest"
  
  [tasks.test-versions]
  description = "Run tests across all Python versions"
  run = [
      { task = "test-py310" },
      { task = "test-py311" },
      { task = "test-py312" },
      { task = "test-py313" },
      { task = "test-py314" },
  ]
  
  [tasks.test-py310]
  description = "Run tests using Python 3.10"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py310" }
  raw_args = true
  run = "uv run --python 3.10 pytest"
  
  [tasks.test-py311]
  description = "Run tests using Python 3.11"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py311" }
  raw_args = true
  run = "uv run --python 3.11 pytest"
  
  [tasks.test-py312]
  description = "Run tests using Python 3.12"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py312" }
  raw_args = true
  run = "uv run --python 3.12 pytest"
  
  [tasks.test-py313]
  description = "Run tests using Python 3.13"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py313" }
  raw_args = true
  run = "uv run --python 3.13 pytest"
  
  [tasks.test-py314]
  description = "Run tests using Python 3.14"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py314" }
  raw_args = true
  run = "uv run --python 3.14 pytest"
  
  [tasks.ti]
  description = "Run tests with debug friendly options"
  raw_args = true
  run = "uv run pytest --numprocesses 0 --no-cov -vv"
  
